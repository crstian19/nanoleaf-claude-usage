# Copy to ~/.config/nanoclaude/env and chmod 600.

# The panel controller on the LAN, and a token from `nanoclaude pair`.
NANOCLAUDE_NANOLEAF_HOST=192.168.1.50
NANOCLAUDE_NANOLEAF_TOKEN=

# Optional: gate the display on a Home Assistant toggle. Omit both to have
# the daemon display for its whole lifetime.
#
# Use https, not the LAN address. A Home Assistant long-lived token is
# unscoped and never expires -- it is full control of the instance, not read
# access to one switch -- and the daemon sends it on every poll. Over plaintext
# that is thousands of exposures a day, recoverable by anyone who can sniff or
# ARP-spoof the network, for the benefit of a wall light. The daemon warns at
# startup if this is http.
HASS_SERVER=https://homeassistant.example.com
HASS_TOKEN=
NANOCLAUDE_TOGGLE_ENTITY=input_boolean.claude_display

# Optional: what counts as a full five-hour window, in tokens. Unset means
# calibrate from this machine's heaviest recorded windows.
#NANOCLAUDE_CEILING_TOKENS=104600000

# Optional: frame rate (1-60, default 20).
#NANOCLAUDE_FPS=20
